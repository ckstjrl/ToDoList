<Window x:Class="ToDoList.Views.CreateTodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="일정 추가" Height="400" Width="300">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="제목" Margin="0,0,0,5" FontWeight="Bold"/>
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

            <TextBlock Text="시작일" Margin="0,0,0,5" FontWeight="Bold"/>
            <DatePicker SelectedDate="{Binding StartDate}" Margin="0,0,0,15"/>

            <TextBlock Text="마감일" Margin="0,0,0,5" FontWeight="Bold"/>
            <DatePicker SelectedDate="{Binding EndDate}" Margin="0,0,0,15"/>

            <TextBlock Text="메모" Margin="0,0,0,5" FontWeight="Bold"/>
            <TextBox Text="{Binding Memo}" Height="80" AcceptsReturn="True"/>

            <Button Content="저장하기" Command="{Binding SaveCommand}" Margin="0,20" Height="35"/>
        </StackPanel>
    </Grid>
</Window>