<Window x:Class="ToDoList.Views.ReadTodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo Detail"
        Height="300"
        Width="400">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">

            <TextBlock Text="시작 날짜"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding StartDate,
                       StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                       Margin="0,0,0,12"/>

            <TextBlock Text="종료 날짜"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding EndDate,
                       StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                       Margin="0,0,0,12"/>

            <TextBlock Text="메모"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Memo}"
                       TextWrapping="Wrap"/>

        </StackPanel>
    </Grid>
</Window>