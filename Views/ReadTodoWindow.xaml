<Window x:Class="ToDoList.Views.ReadTodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo Detail"
        Height="420"
        Width="420">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <TextBox Grid.Row="0"
             Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             FontSize="24"
             FontWeight="Bold"
             Margin="0,0,0,12"
             IsReadOnly="{Binding IsReadOnly}"/>

        <!-- 내용 -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="시작 날짜" FontWeight="SemiBold"/>
            <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"
                        IsEnabled="{Binding IsEditMode}"
                        Margin="0,4,0,12"/>

            <TextBlock Text="종료 날짜" FontWeight="SemiBold"/>
            <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                        IsEnabled="{Binding IsEditMode}"
                        Margin="0,4,0,12"/>

            <TextBlock Text="메모" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}"
                     AcceptsReturn="True"
                     Height="140"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 버튼 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{Binding EditButtonText}"
                    Width="90"
                    Margin="0,0,8,0"
                    Command="{Binding ToggleEditCommand}"/>

            <Button Content="저장"
                    Width="90"
                    Margin="0,0,8,0"
                    Command="{Binding SaveEditCommand}"
                    IsEnabled="{Binding IsEditMode}"/>

            <Button Content="삭제"
                    Width="90"
                    Command="{Binding DeleteCommand}"/>
        </StackPanel>
    </Grid>
</Window>